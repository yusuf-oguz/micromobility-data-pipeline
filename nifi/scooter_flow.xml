<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  NiFi Flow Template: Scooter IoT Pipeline (NiFi 1.25.0 compatible)

  Flow:
    TailFile (/data/scooter_stream.jsonl)
      → SplitText (one record per FlowFile)
        → EvaluateJsonPath (extract routing attrs)
          → RouteOnAttribute
              ├── anomaly/fault → UpdateAttribute (set ES headers) → InvokeHTTP (Elasticsearch)
              └── normal        → UpdateAttribute (set PG attrs)  → PutDatabaseRecord (PostgreSQL)
-->
<template>
  <description>Scooter IoT telemetry pipeline: JSONL → NiFi → PostgreSQL / Elasticsearch</description>
  <groupId>scooter-root-pg</groupId>
  <name>Scooter Pipeline</name>
  <snippet>
    <processGroups>
      <id>scooter-root-pg</id>
      <parentGroupId>root</parentGroupId>
      <position><x>0.0</x><y>0.0</y></position>

      <!-- 1. TailFile -->
      <processors>
        <id>tail-file-proc</id>
        <parentGroupId>scooter-root-pg</parentGroupId>
        <position><x>100.0</x><y>200.0</y></position>
        <config>
          <comments>Reads new lines from simulator JSONL log.</comments>
          <concurrentlySchedulableTaskCount>1</concurrentlySchedulableTaskCount>
          <executionNode>ALL</executionNode>
          <lossTolerant>false</lossTolerant>
          <penaltyDuration>30 sec</penaltyDuration>
          <properties>
            <entry><key>File to Tail</key><value>/data/scooter_stream.jsonl</value></entry>
            <entry><key>tail-mode</key><value>Single file</value></entry>
            <entry><key>Rolling Filename Pattern</key><value>scooter_stream.jsonl.*</value></entry>
            <entry><key>Start Position</key><value>Beginning of File</value></entry>
            <entry><key>Initial Start Position</key><value>Beginning of File</value></entry>
          </properties>
          <schedulingPeriod>1 sec</schedulingPeriod>
          <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
          <yieldDuration>1 sec</yieldDuration>
        </config>
        <name>TailFile - scooter_stream.jsonl</name>
        <relationships>
          <autoTerminate>false</autoTerminate>
          <name>success</name>
        </relationships>
        <state>RUNNING</state>
        <style/>
        <type>org.apache.nifi.processors.standard.TailFile</type>
      </processors>

      <!-- 2. SplitText -->
      <processors>
        <id>split-text-proc</id>
        <parentGroupId>scooter-root-pg</parentGroupId>
        <position><x>400.0</x><y>200.0</y></position>
        <config>
          <comments>One JSON line per FlowFile.</comments>
          <concurrentlySchedulableTaskCount>2</concurrentlySchedulableTaskCount>
          <executionNode>ALL</executionNode>
          <lossTolerant>false</lossTolerant>
          <penaltyDuration>30 sec</penaltyDuration>
          <properties>
            <entry><key>Line Split Count</key><value>1</value></entry>
            <entry><key>Maximum Fragment Size</key><value></value></entry>
            <entry><key>Header Line Count</key><value>0</value></entry>
            <entry><key>Header Line Marker Characters</key><value></value></entry>
            <entry><key>Remove Trailing Newlines</key><value>true</value></entry>
          </properties>
          <schedulingPeriod>0 sec</schedulingPeriod>
          <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
          <yieldDuration>1 sec</yieldDuration>
        </config>
        <name>SplitText - one record per FlowFile</name>
        <relationships>
          <autoTerminate>false</autoTerminate><name>splits</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>original</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>failure</name>
        </relationships>
        <state>RUNNING</state>
        <style/>
        <type>org.apache.nifi.processors.standard.SplitText</type>
      </processors>

      <!-- 3. EvaluateJsonPath -->
      <processors>
        <id>eval-json-proc</id>
        <parentGroupId>scooter-root-pg</parentGroupId>
        <position><x>700.0</x><y>200.0</y></position>
        <config>
          <comments>Extracts anomaly_type, fault_code for routing decision.</comments>
          <concurrentlySchedulableTaskCount>4</concurrentlySchedulableTaskCount>
          <executionNode>ALL</executionNode>
          <lossTolerant>false</lossTolerant>
          <penaltyDuration>30 sec</penaltyDuration>
          <properties>
            <entry><key>Destination</key><value>flowfile-attribute</value></entry>
            <entry><key>Return Type</key><value>auto-detect</value></entry>
            <entry><key>Path Not Found Behavior</key><value>warn</value></entry>
            <entry><key>Null Value Representation</key><value>empty string</value></entry>
            <entry><key>anomaly_type</key><value>$.anomaly_type</value></entry>
            <entry><key>fault_code</key><value>$.fault_code</value></entry>
            <entry><key>event_id</key><value>$.event_id</value></entry>
          </properties>
          <schedulingPeriod>0 sec</schedulingPeriod>
          <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
          <yieldDuration>1 sec</yieldDuration>
        </config>
        <name>EvaluateJsonPath - extract routing attrs</name>
        <relationships>
          <autoTerminate>false</autoTerminate><name>matched</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>unmatched</name>
        </relationships>
        <state>RUNNING</state>
        <style/>
        <type>org.apache.nifi.processors.standard.EvaluateJsonPath</type>
      </processors>

      <!-- 4. RouteOnAttribute -->
      <processors>
        <id>route-proc</id>
        <parentGroupId>scooter-root-pg</parentGroupId>
        <position><x>1000.0</x><y>200.0</y></position>
        <config>
          <comments>Anomalies/faults → Elasticsearch. Normal telemetry → PostgreSQL.</comments>
          <concurrentlySchedulableTaskCount>4</concurrentlySchedulableTaskCount>
          <executionNode>ALL</executionNode>
          <lossTolerant>false</lossTolerant>
          <penaltyDuration>30 sec</penaltyDuration>
          <properties>
            <entry><key>Routing Strategy</key><value>Route to Property name</value></entry>
            <entry>
              <key>to_elastic</key>
              <value>${anomaly_type:isNull():not():or(${fault_code:isNull():not()})}</value>
            </entry>
            <entry>
              <key>to_postgres</key>
              <value>${anomaly_type:isNull():and(${fault_code:isNull()})}</value>
            </entry>
          </properties>
          <schedulingPeriod>0 sec</schedulingPeriod>
          <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
          <yieldDuration>1 sec</yieldDuration>
        </config>
        <name>RouteOnAttribute - elastic vs postgres</name>
        <relationships>
          <autoTerminate>false</autoTerminate><name>to_elastic</name>
        </relationships>
        <relationships>
          <autoTerminate>false</autoTerminate><name>to_postgres</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>unmatched</name>
        </relationships>
        <state>RUNNING</state>
        <style/>
        <type>org.apache.nifi.processors.standard.RouteOnAttribute</type>
      </processors>

      <!-- 5a. UpdateAttribute (ES headers) -->
      <processors>
        <id>update-attr-es-proc</id>
        <parentGroupId>scooter-root-pg</parentGroupId>
        <position><x>1300.0</x><y>0.0</y></position>
        <config>
          <comments>Sets HTTP method and Content-Type for ES InvokeHTTP.</comments>
          <concurrentlySchedulableTaskCount>4</concurrentlySchedulableTaskCount>
          <executionNode>ALL</executionNode>
          <lossTolerant>false</lossTolerant>
          <penaltyDuration>30 sec</penaltyDuration>
          <properties>
            <entry><key>mime.type</key><value>application/json</value></entry>
          </properties>
          <schedulingPeriod>0 sec</schedulingPeriod>
          <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
          <yieldDuration>1 sec</yieldDuration>
        </config>
        <name>UpdateAttribute - set mime.type for ES</name>
        <relationships>
          <autoTerminate>false</autoTerminate><name>success</name>
        </relationships>
        <state>RUNNING</state>
        <style/>
        <type>org.apache.nifi.processors.attributes.UpdateAttribute</type>
      </processors>

      <!-- 5b. InvokeHTTP → Elasticsearch -->
      <processors>
        <id>invoke-http-es-proc</id>
        <parentGroupId>scooter-root-pg</parentGroupId>
        <position><x>1600.0</x><y>0.0</y></position>
        <config>
          <comments>POSTs anomaly JSON to Elasticsearch scooter-alerts index.</comments>
          <concurrentlySchedulableTaskCount>4</concurrentlySchedulableTaskCount>
          <executionNode>ALL</executionNode>
          <lossTolerant>false</lossTolerant>
          <penaltyDuration>30 sec</penaltyDuration>
          <properties>
            <entry><key>HTTP Method</key><value>POST</value></entry>
            <entry><key>Remote URL</key><value>http://elasticsearch:9200/scooter-alerts/_doc</value></entry>
            <entry><key>Content-Type</key><value>application/json</value></entry>
            <entry><key>Basic Authentication Username</key><value>elastic</value></entry>
            <entry><key>Basic Authentication Password</key><value>admin12345</value></entry>
            <entry><key>Connection Timeout</key><value>5 secs</value></entry>
            <entry><key>Read Timeout</key><value>15 secs</value></entry>
            <entry><key>Send Message Body</key><value>true</value></entry>
          </properties>
          <schedulingPeriod>0 sec</schedulingPeriod>
          <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
          <yieldDuration>1 sec</yieldDuration>
        </config>
        <name>InvokeHTTP - POST to Elasticsearch</name>
        <relationships>
          <autoTerminate>true</autoTerminate><name>Response</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>Failure</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>No Retry</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>Original</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>Retry</name>
        </relationships>
        <state>RUNNING</state>
        <style/>
        <type>org.apache.nifi.processors.standard.InvokeHTTP</type>
      </processors>

      <!-- 5c. PutDatabaseRecord → PostgreSQL -->
      <processors>
        <id>put-db-proc</id>
        <parentGroupId>scooter-root-pg</parentGroupId>
        <position><x>1300.0</x><y>400.0</y></position>
        <config>
          <comments>Inserts normal telemetry into PostgreSQL telemetry table via JDBC.</comments>
          <concurrentlySchedulableTaskCount>2</concurrentlySchedulableTaskCount>
          <executionNode>ALL</executionNode>
          <lossTolerant>false</lossTolerant>
          <penaltyDuration>30 sec</penaltyDuration>
          <properties>
            <entry><key>Statement Type</key><value>INSERT</value></entry>
            <entry><key>Schema Name</key><value>public</value></entry>
            <entry><key>Table Name</key><value>telemetry</value></entry>
            <entry><key>Translate Field Names</key><value>true</value></entry>
            <entry><key>Unmatched Field Behavior</key><value>Ignore Unmatched Fields</value></entry>
            <entry><key>Unmatched Column Behavior</key><value>Warn on Unmatched Columns</value></entry>
            <entry><key>Rollback On Failure</key><value>false</value></entry>
          </properties>
          <schedulingPeriod>0 sec</schedulingPeriod>
          <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
          <yieldDuration>1 sec</yieldDuration>
        </config>
        <name>PutDatabaseRecord - telemetry to PostgreSQL</name>
        <relationships>
          <autoTerminate>true</autoTerminate><name>success</name>
        </relationships>
        <relationships>
          <autoTerminate>true</autoTerminate><name>failure</name>
        </relationships>
        <state>RUNNING</state>
        <style/>
        <type>org.apache.nifi.processors.standard.PutDatabaseRecord</type>
      </processors>

    </processGroups>

    <!-- Connections -->
    <connections>
      <id>conn-tail-split</id>
      <parentGroupId>scooter-root-pg</parentGroupId>
      <source><id>tail-file-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></source>
      <destination><id>split-text-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></destination>
      <selectedRelationships>success</selectedRelationships>
      <bends/>
    </connections>
    <connections>
      <id>conn-split-eval</id>
      <parentGroupId>scooter-root-pg</parentGroupId>
      <source><id>split-text-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></source>
      <destination><id>eval-json-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></destination>
      <selectedRelationships>splits</selectedRelationships>
      <bends/>
    </connections>
    <connections>
      <id>conn-eval-route</id>
      <parentGroupId>scooter-root-pg</parentGroupId>
      <source><id>eval-json-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></source>
      <destination><id>route-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></destination>
      <selectedRelationships>matched</selectedRelationships>
      <bends/>
    </connections>
    <connections>
      <id>conn-route-update-es</id>
      <parentGroupId>scooter-root-pg</parentGroupId>
      <source><id>route-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></source>
      <destination><id>update-attr-es-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></destination>
      <selectedRelationships>to_elastic</selectedRelationships>
      <bends/>
    </connections>
    <connections>
      <id>conn-update-es-invoke</id>
      <parentGroupId>scooter-root-pg</parentGroupId>
      <source><id>update-attr-es-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></source>
      <destination><id>invoke-http-es-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></destination>
      <selectedRelationships>success</selectedRelationships>
      <bends/>
    </connections>
    <connections>
      <id>conn-route-pg</id>
      <parentGroupId>scooter-root-pg</parentGroupId>
      <source><id>route-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></source>
      <destination><id>put-db-proc</id><groupId>scooter-root-pg</groupId><type>PROCESSOR</type></destination>
      <selectedRelationships>to_postgres</selectedRelationships>
      <bends/>
    </connections>

  </snippet>
  <timestamp>2026-05-10T00:00:00.000+03:00</timestamp>
</template>
